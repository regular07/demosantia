# Bu dosyayi ".env" adiyla kopyala ve degerleri doldur.
#   cp .env.ornek .env
# .env dosyasi git'e GITMEZ (.gitignore'da).

# Servisin dinleyecegi port
PORT=3001

# PostgreSQL baglantisi (Postgres.app varsayilanlari)
PGHOST=localhost
PGPORT=5432
PGDATABASE=demosantia
PGUSER=orhans
PGPASSWORD=

# Talepleri OKUMAK icin gereken anahtar.
# Form gonderimi (POST) bu anahtari GEREKTIRMEZ - site herkese acik.
# Okuma ve guncelleme (GET/PATCH) bu anahtari ISTER.
# Uzun ve tahmin edilemez bir sey yaz.
YONETIM_ANAHTARI=degistir-bunu-uzun-bir-sey-yap

# Hangi adresten gelen isteklere izin verilecek (CORS)
IZINLI_KAYNAK=http://localhost:8000
